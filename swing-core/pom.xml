<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.imgn.swing</groupId>
    <artifactId>swing-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>swing-core</artifactId>
  <name>swing core</name>
  <description>Lifecycle, scopes, observables, tasks, resources and messages, without Swing.</description>

  <dependencies>
    <dependency>
      <groupId>be.imgn.inject</groupId>
      <artifactId>inject</artifactId>
      <version>${inject.version}</version>
    </dependency>
    <dependency>
      <groupId>be.imgn.toml</groupId>
      <artifactId>toml</artifactId>
      <version>${toml.version}</version>
    </dependency>
    <dependency>
      <groupId>be.imgn.gaia</groupId>
      <artifactId>gaia-core</artifactId>
      <version>${gaia.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- inject's processor reads every annotation and claims none,
               which javac's processing lint reports. -->
          <compilerArgs combine.children="append">
            <arg>-Xlint:-processing</arg>
          </compilerArgs>
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>be.imgn.inject</groupId>
              <artifactId>inject-processor</artifactId>
              <version>${inject.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <!-- The module has no subscriber; its tests have. The tests of the
               bus read the framework's logs through java.util.logging, the
               backend of System.Logger, which the module doesn't require. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>--add-modules</arg>
                <arg>java.logging</arg>
                <arg>--add-reads</arg>
                <arg>be.imgn.swing=java.logging</arg>
              </compilerArgs>
              <annotationProcessorPaths combine.children="append">
                <path>
                  <groupId>be.imgn.gaia</groupId>
                  <artifactId>gaia-processor</artifactId>
                  <version>${gaia.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <!-- On the module path, the tests are patched into the module, whose
               descriptor provides none of their beans, subscriber indexes or
               toml binders: the tests of the event bus and of the settings
               store run on the class path, where the service loader reads
               META-INF/services. -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/CoreWithoutSwingTest.java</exclude>
                <exclude>**/SubscriberRegistrarTest.java</exclude>
                <exclude>**/DefaultSettingsStoreTest.java</exclude>
                <exclude>**/SaveSettingsStepTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>settings-tests</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <useModulePath>false</useModulePath>
              <includes>
                <include>**/DefaultSettingsStoreTest.java</include>
                <include>**/SaveSettingsStepTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>bus-tests</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <useModulePath>false</useModulePath>
              <!-- On the class path, every system module is resolvable: the
                   tests run without java.desktop, as core does. Surefire's
                   booter needs java.management. -->
              <argLine>--limit-modules java.base,java.logging,java.management</argLine>
              <includes>
                <include>**/CoreWithoutSwingTest.java</include>
                <include>**/SubscriberRegistrarTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>be.imgn.inject</groupId>
        <artifactId>inject-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
